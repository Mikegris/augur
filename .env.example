# AUGUR — environment variable overrides (all optional)
# Copy this file to .env and fill in any values you want to set.
# .env is gitignored so nothing here will be committed.

# OpenAI API key — enables AI-generated investment theses, filing summaries,
# earnings briefs. The app falls back to rule-based summaries if missing.
# You can also paste this into the Settings page once the app is running.
# OPENAI_API_KEY=sk-...

# Port for the local web server. Defaults to 5001.
# (macOS reserves 5000 for AirPlay Receiver — pick something else.)
# PORT=5001

# Disable the background dossier pre-warmer (default: enabled).
# Set to 1 if you want lower CPU/network usage in exchange for slower first rolls.
# DISABLE_WARMER=0
